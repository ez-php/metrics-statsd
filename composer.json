{
    "name": "ez-php/metrics-statsd",
    "version": "2.5.0",
    "description": "StatsD/UDP exporter for ez-php/metrics — a dependency-free fire-and-forget StatsD sender.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Uretschnig",
            "email": "andreas.uretschnig@gmail.com"
        }
    ],
    "keywords": [
        "metrics",
        "statsd",
        "udp",
        "monitoring",
        "observability",
        "php",
        "framework",
        "ez-php"
    ],
    "homepage": "https://github.com/ez-php/metrics-statsd",
    "support": {
        "issues": "https://github.com/ez-php/metrics-statsd/issues",
        "source": "https://github.com/ez-php/metrics-statsd"
    },
    "require": {
        "php": "^8.5"
    },
    "suggest": {
        "ez-php/metrics": "Prometheus-side metrics registry this sender complements"
    },
    "require-dev": {
        "ez-php/docker": "^2.0",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EzPhp\\MetricsStatsd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "full": "composer analyse && composer cs && composer test"
    }
}
